{
  "name": "@ai-gurukul/api",
  "version": "1.0.0",
  "private": true,
  "description": "AI Gurukul Core API Service (Express.js + TypeScript)",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ai-gurukul/config": "*",
    "@ai-gurukul/database": "*",
    "@ai-gurukul/embeddings": "*",
    "@ai-gurukul/logging": "*",
    "@ai-gurukul/storage": "*",
    "@ai-gurukul/types": "*",
    "@ai-gurukul/validation": "*",
    "@ai-gurukul/vector-store": "*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "rimraf": "^5.0.5",
    "supertest": "^7.0.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
